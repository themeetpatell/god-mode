{
  "_comment": "Optional hooks for the themeetpatel plugin. These print a small footer after each subagent run showing routing decisions and rough cost. Safe to remove if you prefer a quieter run.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/log-routing.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-summary.js\""
          }
        ]
      }
    ]
  }
}
