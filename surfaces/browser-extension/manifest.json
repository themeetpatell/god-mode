{
  "manifest_version": 3,
  "name": "God Mode",
  "version": "0.1.0",
  "description": "AI Product CEO in your browser sidebar. Roadmap, route, verify, ship — for whatever's on the page.",
  "action": {
    "default_title": "God Mode",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
